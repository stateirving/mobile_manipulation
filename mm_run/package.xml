<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mm_run</name>
  <version>0.0.0</version>
  <description>Mobile manipulation run/launch package</description>
  <maintainer email="benjamin.bogenberger@tum.de">benni</maintainer>
  <license>MIT</license>

  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <depend>mm_simulator</depend>
  <depend>mm_control</depend>
  <depend>mm_plan</depend>
  <depend>mm_utils</depend>
  <depend>mm_assets</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
