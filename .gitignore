# Acados
acados/
c_generated_code/
acados_*

# Casadi
casadi_c*

# Python
__pycache__/
*.py[cod]

# Results/output data
results/

# Keep only compact ESDF grids needed by checked-in ESDF MPC demos.
!mm_run/results/
mm_run/results/**
!mm_run/results/nvblox_esdf/
mm_run/results/nvblox_esdf/**
